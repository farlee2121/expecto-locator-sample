<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <GenerateProgramFile>false</GenerateProgramFile>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Sample.fs" />
    <Compile Include="Main.fs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Expecto" Version="11.0.0-experimental-codelocation2" />
    <PackageReference Include="Expecto.TestLocator.CompilerService" Version="11.0.0-experimental-codelocation2" />
    <PackageReference Include="YoloDev.Expecto.TestSdk" Version="0.16.0-experimental-codelocation2" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.*" />
    <PackageReference Update="FSharp.Core" Version="9.*" />
  </ItemGroup>
</Project>
